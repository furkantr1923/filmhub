{
  "name": "filmhub",
  "productName": "FILMHUB",
  "version": "1.0.0",
  "description": "FILMHUB — Film, dizi ve belgesel keşif & kişisel koleksiyon platformu (Windows, Android, Web).",
  "author": {
    "name": "Furkan Baykal",
    "url": "https://github.com/furkantr1923"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/furkantr1923/filmhub",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch --serve",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node tests/e2e/e2e.mjs",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "android:prepare": "npm run build && npx cap add android && python3 scripts/android-prepare.py && npx cap sync android",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "playwright": "^1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
